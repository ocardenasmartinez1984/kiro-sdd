{
	"info": {
		"_postman_id": "b1f9d7c2-9a3e-4f61-8c2a-user-crud-0001",
		"name": "User CRUD API",
		"description": "Colección para el mantenedor de usuarios (Spring Boot 3, Java 21, H2). Base URL configurable vía la variable {{baseUrl}}. El id del usuario creado se guarda automáticamente en {{userId}}.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Crear usuario",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test('tiene Location header', function () {",
							"    pm.expect(pm.response.headers.has('Location')).to.be.true;",
							"});",
							"var body = pm.response.json();",
							"pm.test('devuelve id generado', function () {",
							"    pm.expect(body.id).to.not.be.undefined;",
							"});",
							"if (body && body.id !== undefined) {",
							"    pm.collectionVariables.set('userId', body.id);",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nombre\": \"Ada Lovelace\",\n    \"email\": \"ada@example.com\",\n    \"activo\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users"
					]
				}
			}
		},
		{
			"name": "Listar usuarios",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('respuesta es un arreglo', function () {",
							"    pm.expect(pm.response.json()).to.be.an('array');",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users"
					]
				}
			}
		},
		{
			"name": "Obtener usuario por id",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('id coincide con {{userId}}', function () {",
							"    pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get('userId')));",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/users/{{userId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"{{userId}}"
					]
				}
			}
		},
		{
			"name": "Actualizar usuario",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('nombre actualizado', function () {",
							"    pm.expect(pm.response.json().nombre).to.eql('Ada L.');",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nombre\": \"Ada L.\",\n    \"email\": \"ada@example.com\",\n    \"activo\": false\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/users/{{userId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"{{userId}}"
					]
				}
			}
		},
		{
			"name": "Eliminar usuario",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status 204', function () {",
							"    pm.response.to.have.status(204);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/users/{{userId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"{{userId}}"
					]
				}
			}
		},
		{
			"name": "Crear usuario - email inválido (400)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status 400', function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"pm.test('incluye detalle de errores', function () {",
							"    pm.expect(pm.response.json()).to.have.property('errors');",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nombre\": \"\",\n    \"email\": \"no-es-un-email\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users"
					]
				}
			}
		},
		{
			"name": "Obtener usuario inexistente (404)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status 404', function () {",
							"    pm.response.to.have.status(404);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/users/999999",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"999999"
					]
				}
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "",
			"type": "string"
		}
	]
}
