# Artefactos de build.
# El Dockerfile es runtime-only y necesita el JAR ejecutable de target/,
# así que se excluye todo target/ salvo ese artefacto.
target/*
!target/user-crud-*.jar
*.war

# Control de versiones
.git/
.gitignore

# Metadatos de Kiro / spec
.kiro/

# Archivos de IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Docker
Dockerfile
.dockerignore
docker-compose.yml

# Sistema operativo
.DS_Store
Thumbs.db

# Documentación / colecciones que no afectan el build
README.md
*.postman_collection.json
